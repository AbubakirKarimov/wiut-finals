# Copy to .env and fill in. Never commit .env.

# SQLite database file
DB_PATH=data/compliance.sqlite

# LLM provider: "api" or "local"
LLM_PROVIDER=api

# API provider (OpenAI-compatible or Anthropic endpoint; set what you use)
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=

# Local provider (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# LLM prices in USD per 1M tokens; leave empty if unknown (reports will say "не задана")
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Crawler
CRAWLER_USER_AGENT=ComplianceRadar/0.1 (WIUT hackathon; consumer-protection research bot)
CRAWLER_MAX_PAGES_PER_BANK=60
CRAWLER_MAX_DEPTH=2
CRAWLER_MIN_DELAY_SECONDS=1.0

# Frontend -> backend URL
VITE_API_BASE_URL=http://localhost:8000

# Backend CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173
