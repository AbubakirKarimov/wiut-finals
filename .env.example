# Copy to .env and fill in. Never commit .env.

# SQLite database file
DB_PATH=data/compliance.sqlite
# Approved requirements loaded at API startup (default data/requirements.yaml)
REQUIREMENTS_PATH=

# Primary LLM: any OpenAI-compatible endpoint (Gemini, Groq, OpenRouter, Ollama).
# Base URL examples (check the provider's docs):
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Prices in USD per 1M tokens; leave empty if unknown (reports will say "not set")
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Request timeout and JSON mode (sends response_format=json_object; set 0 if the
# provider/model rejects it)
LLM_TIMEOUT_SECONDS=60
LLM_JSON_MODE=1
# Pacing: retries on 429/5xx/timeout (Retry-After is honoured up to LLM_MAX_WAIT_SECONDS,
# otherwise wait = LLM_BACKOFF_SECONDS * 2^attempt), and a minimum gap between API calls.
LLM_MAX_RETRIES=3
LLM_BACKOFF_SECONDS=2
LLM_MAX_WAIT_SECONDS=60
LLM_MIN_INTERVAL_SECONDS=1
# With LLM_FALLBACK_1_* configured: a rate-limit wait longer than this switches to the fallback
LLM_FALLBACK_AFTER_SECONDS=30
# Cap on output tokens per call (reasoning models count their reasoning here; raise it if
# answers come back cut off). Empty = provider default. Fallback slots inherit it.
LLM_MAX_OUTPUT_TOKENS=1000
# Optional reasoning effort (low | medium | high) sent as `reasoning_effort`. Set it only
# for models that accept it, e.g. gpt-oss models on Groq; other models may reject it.
# Per fallback slot: LLM_FALLBACK_1_REASONING_EFFORT.
LLM_REASONING_EFFORT=

# Optional fallback providers, tried in order on HTTP 429, 5xx or timeout.
# Add LLM_FALLBACK_2_*, LLM_FALLBACK_3_* the same way; empty slots are ignored.
LLM_FALLBACK_1_BASE_URL=
LLM_FALLBACK_1_API_KEY=
LLM_FALLBACK_1_MODEL=
LLM_FALLBACK_1_PRICE_INPUT_PER_MTOK=
LLM_FALLBACK_1_PRICE_OUTPUT_PER_MTOK=

# Local Ollama endpoint for scripts/bench_local.py
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Crawler
CRAWLER_USER_AGENT=ComplianceRadar/0.1 (WIUT hackathon; consumer-protection research bot)
CRAWLER_MAX_PAGES_PER_BANK=15
CRAWLER_MAX_DEPTH=2
CRAWLER_MIN_DELAY_SECONDS=1.0
# Wall-clock cap per bank crawl (the hosted demo uses 60)
CRAWLER_TIME_BUDGET_SECONDS=60
# Max size of one downloaded HTML page or PDF
CRAWLER_MAX_FILE_MB=10
# Max PDF pages read with pdfplumber
CRAWLER_MAX_PDF_PAGES=30
# Re-runs reuse pages fetched within this many hours instead of requesting them again
# (resumable crawl; 0 = always fetch)
CRAWLER_CACHE_MAX_AGE_HOURS=24
# Playwright fallback for JavaScript-only sites (set 0 on the hosted demo)
BROWSER_FALLBACK=1
# Wait for network idle up to this many seconds; one retry
BROWSER_TIMEOUT_SECONDS=45
# Probe (scripts/probe_banks.py): a 200 page with less visible text than this is js_shell
PROBE_MIN_TEXT_CHARS=500
PROBE_TIMEOUT_SECONDS=15

# Frontend -> backend URL
VITE_API_BASE_URL=http://localhost:8000

# Backend CORS: browser origins allowed to call the API (comma-separated, scheme://host[:port],
# no path, no '*'). Empty = local defaults: http://localhost:5173, http://127.0.0.1:5173,
# http://localhost:5174, http://127.0.0.1:5174. In production set the hosted frontend,
# e.g. CORS_ORIGINS=https://wiut-finals.vercel.app (the defaults then no longer apply).
CORS_ORIGINS=

# Max POST /check requests per client IP per minute
CHECK_RATE_LIMIT_PER_MINUTE=5
# Checks running at the same time (others wait in the queue)
MAX_CONCURRENT_CHECKS=2
# LOCAL TESTS ONLY: 1 lets POST /check crawl http:// and private/localhost addresses
CHECK_ALLOW_PRIVATE_URLS=0

# Checks
# possible_gap requires at least this many pages read (and no fetch errors)
CHECK_MIN_PAGES_FOR_GAP=5
# Candidate pages sent to the LLM per requirement (one call each)
CHECK_LLM_MAX_PAGES=2
# Context per LLM call: passages of +-CHECK_EXCERPT_WINDOW_CHARS around keyword hits, at most
# CHECK_MAX_CONTEXT_TOKENS (estimated as 2.5 characters per token). Whole pages are never sent.
CHECK_EXCERPT_WINDOW_CHARS=1500
CHECK_MAX_CONTEXT_TOKENS=2500
# Time limits: per check (LLM calls and rate-limit waits) and for all checks of one run.
# A check out of time is not_checkable "LLM timeout / rate limit", never possible_gap.
CHECK_TIMEOUT_SECONDS=90
CHECK_RUN_BUDGET_SECONDS=900
# Shortest quote accepted as evidence
CHECK_MIN_QUOTE_CHARS=12
# Optional: uz_version reports possible_gap when the Uzbek share of uz+ru pages is below
# this value (0..1). Empty = only "no Uzbek page at all" is a gap.
UZ_VERSION_MIN_SHARE=
